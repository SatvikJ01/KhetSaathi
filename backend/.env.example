# Copy to backend/.env and fill in. Never commit .env.

# LLM provider: gemini | openai | anthropic
LLM_PROVIDER=gemini
# Optional model override (blank = provider default from app/agent/llm.py)
LLM_MODEL=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Free key from https://data.gov.in (sign in -> My Account -> API key). Needed for mandi prices.
DATA_GOV_API_KEY=
# https://dashboard.sarvam.ai (voice in/out, Indic languages)
SARVAM_API_KEY=

CORS_ORIGINS=http://localhost:5173
